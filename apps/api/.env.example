# Runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Optional absolute directory for local images and private résumés.
# UPLOAD_ROOT=

# PostgreSQL
# The required database name is: the-property-pillar
DATABASE_URL="postgresql://postgres:password@127.0.0.1:55432/the-property-pillar?schema=public"
PUBLIC_TENANT_ID="the-property-pillar-marketplace"

# Comma-separated frontend origins. Never use * with credentialed requests.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# JWT browser session. Generate a unique high-entropy secret for every environment.
JWT_SECRET=""
JWT_ISSUER="the-property-pillar-api"
JWT_AUDIENCE="the-property-pillar-web"
JWT_CLOCK_TOLERANCE_SECONDS=5

# Optional Google OAuth web client. Register this exact callback URI in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# Registration verification email. Use port 465 for implicit TLS or 587 for STARTTLS.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Razorpay checkout keys. Seller and plans are in apps/api/data/billing.local.json.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Session and abuse controls
SESSION_COOKIE_NAME=tpp_session
SESSION_TTL_DAYS=7
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=false
