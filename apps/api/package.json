{
  "name": "@the-property-pillar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ThePropertyPillar Express API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "accounts:create-local": "tsx src/scripts/create-panel-accounts.ts",
    "plans:seed-local": "tsx src/scripts/seed-listing-plans.ts",
    "projects:backfill": "tsx src/scripts/backfill-projects.ts",
    "properties:backfill": "tsx src/scripts/backfill-properties.ts",
    "profiles:backfill": "tsx src/scripts/backfill-role-profiles.ts",
    "rfqs:backfill": "tsx src/scripts/backfill-market-requests.ts",
    "products:backfill": "tsx src/scripts/backfill-material-products.ts",
    "materials:backfill": "tsx src/scripts/backfill-material-matching.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "cross-env NODE_ENV=test JWT_SECRET=test-only-jwt-secret-never-use-outside-automated-tests-2026 tsx --test --test-isolation=none tests/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "smoke:billing": "tsx ../../scripts/smoke-billing.mjs"
  },
  "dependencies": {
    "@file-type/cfbf": "^0.2.2",
    "@prisma/client": "^6.19.3",
    "@the-property-pillar/contracts": "workspace:*",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "country-codes-list": "^3.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.17",
    "libphonenumber-js": "^1.13.16",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "sanitize-html": "^2.18.2",
    "sharp": "0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "prisma": "^6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  }
}
