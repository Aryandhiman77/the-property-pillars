generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  OWNER
  DEALER
  BUILDER
  VENDOR
  PROFESSIONAL
  WHITE_COLLAR_SEEKER
  BLUE_COLLAR_WORKER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum HomepageSlideStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PropertyMapLeadStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

enum WorkspaceCollection {
  PROPERTIES
  DEALER_PROFILES
  SAVED_PROPERTIES
  BUYER_ALERTS
  PROPERTY_INQUIRIES
  MATERIAL_PRODUCTS
  MATERIAL_RFQS
  MATERIAL_QUOTES
  SERVICE_PROFILES
  SERVICE_INQUIRIES
  JOBS
  JOB_APPLICATIONS
  WORKER_PROFILES
  BUILDER_PROJECTS
  AD_CAMPAIGNS
  LOAN_INQUIRIES
  GRIEVANCES
}

enum BillingProvider {
  RAZORPAY
}

enum BillingOrderStatus {
  CREATING
  PAYMENT_PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum EntitlementType {
  DEALER_PRO
  BUILDER_AD_CAMPAIGN
  FEATURED_JOB_BOOST
  LISTING_FEATURE
  POSTING_CREDITS
  PROFILE_FEATURE
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Tenant {
  masters MasterItem[]
  masterCatalogVersion Int @default(0)
  roleReviews LegacyRoleReview[]
  id        String   @id @default(cuid())
  name      String
  isDemo    Boolean  @default(false)
  accentColor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  sessions        Session[]
  workspaceItems  WorkspaceItem[]
  plans ListingPlan[]
  workspaceEvents WorkspaceEvent[]
  billingOrders   BillingOrder[]
  billingInvoices BillingInvoice[]
  billingEvents   BillingEvent[]
  entitlements    BillingEntitlement[]
  homepageSlides  HomepageSlide[]
  propertyMapLeads PropertyMapLead[]
  propertyComments PropertyComment[]
  articles Article[]
  mobileChallenges MobileChallenge[]

  @@index([isDemo])
}

model User {
  savedJobs SavedJob[]
  domainProfiles DomainProfile[]
  profileDecisions ProfileDecision[]
  legacyRoleReview LegacyRoleReview? @relation("ReviewedUser")
  roleDecisions LegacyRoleReview[] @relation("Reviewer")
  id           String     @id @default(cuid())
  tenantId     String
  phone        String?    @unique
  email        String?    @unique
  googleSubject String?   @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  emailVerificationCodeHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetCodeHash String?
  passwordResetExpiresAt DateTime?
  pendingRegistrationPhone String?
  passwordHash String?
  fullName     String
  aboutMe      String?
  profileLocation String?
  profileLogoUrl String?
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      Session[]
  ownedItems    WorkspaceItem[]      @relation("WorkspaceOwner")
  targetedItems WorkspaceItem[]      @relation("WorkspaceTarget")
  auditEvents   WorkspaceEvent[]
  notificationReads WorkspaceNotificationRead[]
  billingOrders BillingOrder[]
  entitlements  BillingEntitlement[]
  propertyMapLeads PropertyMapLead[]
  propertyComments PropertyComment[]
  propertyInterests PropertyInterest[]

  @@index([tenantId, role, status])
}

model Session {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  tokenHash  String    @unique
  activeRole UserRole
  demo       Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, revokedAt])
  @@index([expiresAt])
}

model MobileChallenge {
  id           String   @id
  tenantId     String
  phone        String
  browserHash  String
  ipHash       String
  codeHash     String
  profile      Json?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phone, createdAt])
  @@index([tenantId, ipHash, createdAt])
}

model Article {
  id           String        @id @default(cuid())
  tenantId     String
  slug         String
  title        String
  summary      String
  coverImage   String
  imageAlt     String
  bodyHtml     String
  tags         String[]
  topic        String        @default("NEWS")
  city         String?
  countryCode  String?
  propertyType String?
  socialLinks  Json
  readMinutes  Int
  status       ArticleStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  translations ArticleTranslation[]
  interactions ArticleInteraction[]
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt, id])
  @@index([tenantId, coverImage])
}

model ArticleTranslation {
  articleId String
  locale    String
  version   String
  metadata  Json?
  bodyHtml  String?
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, locale, version])
}

model ArticleInteraction {
  articleId String
  kind      String
  key       String
  createdAt DateTime @default(now())
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, kind, key])
}

/// Domain records share a storage envelope while collection-specific Zod
/// schemas, permissions and transitions are enforced before every write.
model WorkspaceItem {
  materialRfq MaterialRFQ?
  materialQuote MaterialQuote?
  marketplaceFiles MarketplaceFile[]
  materialProduct MaterialProduct?
  builderProject BuilderProject?
  property Property?
  savedByJobSeekers SavedJob[]
  id           String              @id @default(cuid())
  tenantId     String
  collection   WorkspaceCollection
  title        String
  description  String?
  status       String
  data         Json                @default("{}")
  ownerId      String?
  targetUserId String?
  parentId     String?
  publicAt     DateTime?
  featuredAt   DateTime?
  featuredOrder Int?
  featureRequestStatus String?
  enquiryRequestKey String?
  searchPrice  Decimal?            @db.Decimal(20, 4)
  pricePerSqft Decimal?            @db.Decimal(24, 6)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner      User?            @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetUser User?            @relation("WorkspaceTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  parent     WorkspaceItem?   @relation("WorkspaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   WorkspaceItem[]  @relation("WorkspaceHierarchy")
  events     WorkspaceEvent[]
  mapLeads   PropertyMapLead[]
  comments   PropertyComment[]
  propertyViews PropertyView[]
  enquiryEmail PropertyEnquiryEmail?

  @@index([tenantId, collection, status, publicAt])
  @@unique([tenantId, featuredOrder])
  @@unique([tenantId, enquiryRequestKey])
  @@index([tenantId, collection, status, searchPrice, id])
  @@index([tenantId, collection, status, pricePerSqft])
  @@index([tenantId, ownerId, collection, updatedAt])
  @@index([tenantId, targetUserId, collection, updatedAt])
  @@index([tenantId, parentId])
}

model HomepageSlide {
  id          String              @id @default(cuid())
  tenantId    String
  title       String
  description String?
  imageUrl    String
  videoUrl    String?
  imageAlt    String
  ctaLabel    String?
  ctaHref     String?
  sortOrder   Int
  status      HomepageSlideStatus @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, sortOrder])
}

model PropertyMapLead {
  id           String                @id @default(cuid())
  tenantId     String
  propertyId   String
  posterId     String
  contact      String
  phoneHash    String
  isDealer     Boolean
  visitorType  String?
  status       PropertyMapLeadStatus @default(NEW)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property     WorkspaceItem         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  poster       User                  @relation(fields: [posterId], references: [id], onDelete: Cascade)

  @@unique([propertyId, phoneHash])
  @@index([tenantId, posterId, createdAt, id])
}

model WorkspaceEvent {
  id         String   @id @default(cuid())
  tenantId   String
  itemId     String
  actorId    String?
  action     String
  fromStatus String?
  toStatus   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   WorkspaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor  User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  notificationReads WorkspaceNotificationRead[]

  @@index([tenantId, itemId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@index([tenantId, createdAt, id])
}

model PropertyComment {
  id          String   @id @default(cuid())
  tenantId    String
  propertyId  String
  authorId    String?
  fullName    String
  phone       String
  body        String
  requestKey  String
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    WorkspaceItem @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author      User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, requestKey])
  @@index([tenantId, propertyId, hidden, createdAt, id])
  @@index([tenantId, createdAt, id])
}

model PropertyView {
  propertyId  String
  visitorHash String
  property    WorkspaceItem @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, visitorHash])
}

model PropertyInterest {
  userId    String
  signature String
  data      Json
  searchedAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, signature])
  @@index([userId, searchedAt])
}

model PropertyEnquiryEmail {
  enquiryId   String   @id
  locale      String
  nextAttempt DateTime @default(now())
  attempts    Int      @default(0)
  sentAt      DateTime?
  failedAt    DateTime?
  enquiry     WorkspaceItem @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([sentAt, failedAt, nextAttempt])
}

model WorkspaceNotificationRead {
  userId String
  eventId String
  readAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event WorkspaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

model BillingOrder {
  id                 String             @id @default(cuid())
  tenantId           String
  userId             String
  provider           BillingProvider    @default(RAZORPAY)
  status             BillingOrderStatus @default(CREATING)
  priceId            String
  postingCredits     Int @default(0)
  planName           String
  entitlementType    EntitlementType
  entitlementDays    Int
  targetId           String?
  idempotencyKey     String
  requestHash        String
  receipt            String             @unique
  providerOrderId    String?            @unique
  providerPaymentId  String?            @unique
  currency           String             @default("INR")
  basePaise          Int
  taxRateBps         Int
  taxPaise           Int
  totalPaise         Int
  billingSnapshot    Json
  supplierSnapshot   Json
  termsAcceptedAt    DateTime
  capturedAt         DateTime?
  failedAt           DateTime?
  refundedAt         DateTime?
  failureCode        String?
  failureDescription String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoice     BillingInvoice?
  entitlement BillingEntitlement?
  events      BillingEvent[]

  @@unique([tenantId, userId, idempotencyKey])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, targetId])
}

model ListingPlan {
  id              String @id @default(uuid())
  tenantId        String
  name            String
  description     String
  aboutHtml       String
  highlights      String[]
  audience        String
  purpose         String
  basePaise       Int
  taxRateBps      Int
  serviceCode     String
  entitlementDays Int
  postingCredits  Int
  active          Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active, audience])
}

model PropertyPost {
  propertyId String @id
  tenantId String
  userId String
  sourceOrderId String?
  postedAt DateTime @default(now())
  @@index([tenantId, userId, sourceOrderId])
}

model BillingInvoice {
  id               String   @id @default(cuid())
  tenantId         String
  orderId          String   @unique
  invoiceNumber    String   @unique
  financialYear    String
  sequenceNumber   Int
  issuedAt         DateTime @default(now())
  currency         String   @default("INR")
  basePaise        Int
  cgstPaise        Int
  sgstPaise        Int
  igstPaise        Int
  taxPaise         Int
  totalPaise       Int
  supplierSnapshot Json
  customerSnapshot Json

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  BillingOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([financialYear, sequenceNumber])
  @@index([tenantId, issuedAt])
}

model BillingInvoiceSequence {
  financialYear String   @id
  lastNumber    Int
  updatedAt     DateTime @updatedAt
}

model BillingEntitlement {
  id            String            @id @default(cuid())
  tenantId      String
  userId        String
  type          EntitlementType
  status        EntitlementStatus @default(ACTIVE)
  targetId      String?
  sourceOrderId String            @unique
  startsAt      DateTime          @default(now())
  endsAt        DateTime
  revokedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceOrder BillingOrder @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId, type, status, endsAt])
  @@index([tenantId, targetId, type, status, endsAt])
}

model BillingEvent {
  id                String   @id @default(cuid())
  tenantId          String
  orderId           String
  providerEventId   String   @unique
  eventType         String
  providerPaymentId String?
  payloadHash       String
  metadata          Json     @default("{}")
  processedAt       DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  BillingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId, processedAt])
}

model LegacyRoleReview {
  userId String @id
  tenantId String
  originalRole UserRole
  reason String
  decidedRole UserRole?
  decidedById String?
  decisionNote String?
  decidedAt DateTime?
  user User @relation("ReviewedUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewer User? @relation("Reviewer", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([tenantId, decidedAt, userId], map: "LegacyRoleReview_queue")
}

enum ProfileVerification {
  NOT_SUBMITTED
  PENDING
  CHANGES_REQUIRED
  VERIFIED
  REJECTED
  SUSPENDED
}

model DomainProfile {
  id String @id @default(cuid())
  userId String
  role UserRole
  revision Int @default(0)
  verification ProfileVerification @default(NOT_SUBMITTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  choices ProfileChoice[]
  files ProfileFile[]
  history ProfileDecision[]
  buyerProfile BuyerProfile?
  ownerProfile OwnerProfile?
  dealerProfile DealerProfile?
  builderProfile BuilderProfile?
  vendorProfile VendorProfile?
  professionalProfile ProfessionalProfile?
  jobSeekerProfile JobSeekerProfile?
  workerProfile WorkerProfile?
  @@unique([userId,role])
  @@index([verification,updatedAt])
}

model MasterItem {
  rfqCategories MaterialRFQItem[] @relation("RFQCategory")
  rfqSubcategories MaterialRFQItem[] @relation("RFQSubcategory")
  rfqUnits MaterialRFQItem[] @relation("RFQUnit")
  serviceCategories ProfessionalService[] @relation("ServiceCategory")
  serviceSubcategories ProfessionalService[] @relation("ServiceSubcategory")
  serviceLocations ProfessionalServiceArea[]
  materialCategoryProducts MaterialProduct[] @relation("ProductCategory")
  materialSubcategoryProducts MaterialProduct[] @relation("ProductSubcategory")
  materialSaleUnits MaterialProduct[] @relation("ProductSaleUnit")
  materialDeliveryAreas MaterialProductDeliveryArea[]
  specificationCategories ProductSpecificationDefinition[] @relation("SpecCategory")
  specificationSubcategories ProductSpecificationDefinition[] @relation("SpecSubcategory")
  builderProjectcountry BuilderProject[] @relation("BuilderProjectcountry")
  builderProjectstate BuilderProject[] @relation("BuilderProjectstate")
  builderProjectcity BuilderProject[] @relation("BuilderProjectcity")
  builderProjectlocality BuilderProject[] @relation("BuilderProjectlocality")
  builderProjectareaUnit BuilderProject[] @relation("BuilderProjectareaUnit")
  projectUnitareaUnit ProjectUnit[] @relation("ProjectUnitareaUnit")
  projectConfigurationcategory ProjectConfiguration[] @relation("ProjectConfigurationcategory")
  projectConfigurationtype ProjectConfiguration[] @relation("ProjectConfigurationtype")
  projectConfigurationareaUnit ProjectConfiguration[] @relation("ProjectConfigurationareaUnit")
  projectAmenitymaster ProjectAmenity[] @relation("ProjectAmenitymaster")
  projectPlanareaUnit ProjectPlan[] @relation("ProjectPlanareaUnit")
  categoryProperties Property[] @relation("Propertycategory")
  typeProperties Property[] @relation("Propertytype")
  areaUnitProperties Property[] @relation("PropertyareaUnit")
  countryProperties Property[] @relation("Propertycountry")
  stateProperties Property[] @relation("Propertystate")
  cityProperties Property[] @relation("Propertycity")
  localityProperties Property[] @relation("Propertylocality")
  propertyAmenities PropertyAmenity[]
  floorPlans PropertyFloorPlan[]
  measuredAreas PropertyArea[]
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  kind String
  code String
  name String
  parentId String?
  parent MasterItem? @relation("MasterTree",fields:[parentId],references:[id],onDelete:Restrict)
  children MasterItem[] @relation("MasterTree")
  active Boolean @default(true)
  sortOrder Int @default(0)
  latitude Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  choices ProfileChoice[]
  @@unique([tenantId,kind,code])
  @@index([tenantId,kind,parentId,active,sortOrder])
}

model ProfileChoice {
  profileId String
  field String
  masterId String
  profile DomainProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  master MasterItem @relation(fields:[masterId],references:[id],onDelete:Restrict)
  @@id([profileId,field,masterId])
  @@index([masterId])
}

model ProfileFile {
  id String @id @default(cuid())
  profileId String
  profile DomainProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  field String
  category String
  visibility String @default("PROTECTED")
  storageKey String @unique
  originalName String
  mime String
  size Int
  createdAt DateTime @default(now())
  @@index([profileId,field,createdAt])
}

model ProfileDecision {
  id String @id @default(cuid())
  profileId String
  profile DomainProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  actorId String
  actor User @relation(fields:[actorId], references:[id],onDelete:Restrict)
  fromState ProfileVerification
  toState ProfileVerification
  reason String?
  revision Int
  createdAt DateTime @default(now())
  @@index([profileId,createdAt])
}

model ProfileMigrationNote {
  sourceId String @id
  role UserRole?
  profileId String?
  mappedFields String[]
  retainedFields String[]
  note String
  createdAt DateTime @default(now())
}

model BuyerProfile {
  profileId String @id
  profile DomainProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  whatsapp String?
  preferredLanguage String?
  lookingFor String[] @default([])
  configuration String[] @default([])
  possession String?
  homeLoan Boolean?
  budgetMin Float?
  budgetMax Float?
  currency String?
  alertChannels String[] @default([])
}

model OwnerProfile {
  properties Property[]
  profileId String @id
  profile DomainProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  ownerType String?
  whatsapp String?
  preferredLanguage String?
  postalCode String?
  address String?
  latitude Float?
  longitude Float?
}

model DealerProfile {
  properties Property[]
  profileId String @id
  profile DomainProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  designation String?
  whatsapp String?
  preferredLanguage String?
  agencyName String?
  businessType String?
  establishedYear Int?
  yearsExperience Int?
  teamSize Int?
  about String?
  website String?
  postalCode String?
  address String?
  latitude Float?
  longitude Float?
  reraRegistered Boolean?
  reraNumber String?
  reraAuthority String?
  issueDate String?
  expiryDate String?
  specializations String[] @default([])
  languages String[] @default([])
  workingDays String[] @default([])
  workingHours String?
  contactChannel String?
  facebookUrl String?
  instagramUrl String?
  linkedinUrl String?
  youtubeUrl String?
  whatsappchannelUrl String?
}

model BuilderProfile {
  projects BuilderProject[]
  properties Property[]
  profileId String @id
  profile DomainProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  brandName String?
  legalName String?
  businessType String?
  establishedYear Int?
  about String?
  website String?
  completedProjects Int?
  ongoingProjects Int?
  representative String?
  designation String?
  contactPhone String?
  contactEmail String?
  whatsapp String?
  preferredLanguage String?
  postalCode String?
  address String?
  latitude Float?
  longitude Float?
  reraRegistered Boolean?
  reraNumber String?
  reraAuthority String?
  issueDate String?
  expiryDate String?
  companyReference String?
  taxReference String?
  specializations String[] @default([])
  facebookUrl String?
  instagramUrl String?
  linkedinUrl String?
  youtubeUrl String?
  whatsappchannelUrl String?
}

// Identity, title, description, publication, moderation history and billing targets
// use the original workspace ID. Product-specific values live in these relations.
model MaterialProduct {
  id String @id
  workspace WorkspaceItem @relation(fields:[id],references:[id],onDelete:Cascade)
  tenantId String
  quoteLines MaterialQuoteItem[]
  vendorProfileId String?
  vendor VendorProfile? @relation(fields:[vendorProfileId],references:[profileId],onDelete:Restrict)
  reference String?
  sku String?
  brand String?
  model String?
  summary String?
  categoryId String?
  category MasterItem? @relation("ProductCategory",fields:[categoryId],references:[id],onDelete:Restrict)
  subcategoryId String?
  subcategory MasterItem? @relation("ProductSubcategory",fields:[subcategoryId],references:[id],onDelete:Restrict)
  unitId String?
  unit MasterItem? @relation("ProductSaleUnit",fields:[unitId],references:[id],onDelete:Restrict)
  pricingType String?
  minPrice Decimal? @db.Decimal(22,6)
  maxPrice Decimal? @db.Decimal(22,6)
  currency String?
  includesTax Boolean?
  minimumQuantity Decimal? @db.Decimal(22,6)
  availability String?
  delivery Boolean?
  pickup Boolean?
  radiusKm Float?
  leadTimeValue Int?
  leadTimeUnit String?
  deliveryNotes String?
  specificationText String?
  media MaterialProductMedia[]
