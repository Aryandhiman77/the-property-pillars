# API runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"
TRUST_PROXY=false

# Website and same-origin API proxy
API_PROXY_TARGET="http://127.0.0.1:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_BUILD_DIR=""

# PostgreSQL database name: the-property-pillar.
# Leave DATABASE_URL blank to use the values generated in apps/api/.env by pnpm db:local.
DATABASE_URL=""
PUBLIC_TENANT_ID="the-property-pillar-marketplace"
TPP_POSTGRES_BIN=""

# Browser sessions and abuse controls
JWT_SECRET=""
JWT_ISSUER="the-property-pillar-api"
JWT_AUDIENCE="the-property-pillar-web"
JWT_CLOCK_TOLERANCE_SECONDS=5
SESSION_COOKIE_NAME=tpp_session
SESSION_TTL_DAYS=7
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
ALLOW_ADMIN_BOOTSTRAP=false

# Optional absolute directory for local images and private resumes.
UPLOAD_ROOT=""

# Google OAuth web client. Register this exact website callback in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# Razorpay checkout keys. Seller and plans are in apps/api/data/billing.local.json.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# SMTP for email verification. SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
