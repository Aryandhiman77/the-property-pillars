# API runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"
TRUST_PROXY=false

# Website and same-origin API proxy
API_PROXY_TARGET="http://127.0.0.1:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_BUILD_DIR=""

# PostgreSQL database name: the-property-pillar.
# Leave DATABASE_URL blank to use the values generated in apps/api/.env by pnpm db:local.
DATABASE_URL=""
PUBLIC_TENANT_ID="the-property-pillar-marketplace"
TPP_POSTGRES_BIN=""

# Browser sessions and abuse controls
JWT_SECRET=""
JWT_ISSUER="the-property-pillar-api"
JWT_AUDIENCE="the-property-pillar-web"
JWT_CLOCK_TOLERANCE_SECONDS=5
SESSION_COOKIE_NAME=tpp_session
SESSION_TTL_DAYS=7
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
ALLOW_ADMIN_BOOTSTRAP=false

# Optional absolute directory for local images and private resumes.
UPLOAD_ROOT=""
MEDIA_IMAGE_MAX_MB=8
MEDIA_VIDEO_MAX_MB=100
MEDIA_IMAGE_INPUT_MAX_MB=32
MEDIA_VIDEO_INPUT_MAX_MB=250
FFMPEG_PATH=""
FFPROBE_PATH=""
MAP_LEAD_DATA_KEY=""

# Google OAuth web client. Register this exact website callback in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
# Optional Google People API phone prefill. Enable People API and approve the phone scope first.
GOOGLE_OAUTH_READ_PHONE=true

# Razorpay checkout keys. Invoice issuer settings and legacy offers use apps/api/data/billing.local.json.
# Manage property posting and featuring plans in Dashboard > Plans & billing.
# Self-hosted CKEditor license key for the plan editor (defaults to GPL mode).
NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional path to the reviewed seller profile and plan prices.
BILLING_CONFIG_FILE=""

# SMTP for account verification and property enquiry emails. SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Article translation. Restrict the key to Google Cloud Translation.
GOOGLE_TRANSLATION_API_KEY=

# Mobile SMS delivery. Leave blank for the local development code flow.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Optional OpenStreetMap Overpass endpoint. The bundled GeoNames catalog is used by default.
NEARBY_PLACES_OVERPASS_URL=
# Listing text and media screening, server only. Public submissions require a successful check.
GEMINI_API_KEY=""
GEMINI_MODERATION_MODEL="gemini-3.5-flash-lite"

# Optional server-side token for permanent profile address geocoding
MAPBOX_GEOCODING_TOKEN=""
