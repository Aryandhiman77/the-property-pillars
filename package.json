{
  "name": "the-property-pillar",
  "version": "0.1.0",
  "private": true,
  "description": "ThePropertyPillar.com monorepo",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@the-property-pillar/web",
    "dev:api": "turbo run dev --filter=@the-property-pillar/api",
    "db:local": "node scripts/local-postgres.cjs",
    "db:local:stop": "node scripts/local-postgres.cjs stop",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "smoke:local": "node scripts/smoke-local.mjs",
    "uat:local": "node scripts/manual-uat.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
