# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
.next-*/
dist/
build/
out/
.turbo/
.turbo.zip
coverage/
*.tsbuildinfo

# Local environment files (the example is intentionally tracked)
.env
.env.*
!.env.example
!.env.*.example
/apps/api/data/billing.local.json
panel-credentials.json
panel-credentials.*.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime and uploads
tmp/
temp/
uploads/
*-uploads/
# These directories contain the API handlers for uploads.
!/apps/api/src/uploads/
!/apps/web/src/app/api/v1/uploads/

# Local database backups (Prisma migrations and runtime catalogs are source files)
/backups/
*.dump
*.sql.gz

# Editors and operating systems
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# Test and browser artifacts
playwright-report/
test-results/


# Private role-profile files stored beside the public upload root
*-profile-private/
*-property-private/
